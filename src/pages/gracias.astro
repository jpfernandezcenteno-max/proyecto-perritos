---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Toggle from "../components/islands/Toggle";
import ShareButton from "../components/islands/ShareButton";
import { dataAdapter } from "../lib/data";
import { formatSoles } from "../lib/format";

const shelterSlug = Astro.url.searchParams.get("shelter") ?? undefined;
const monto = Number(Astro.url.searchParams.get("monto") ?? 0);

const shelter = shelterSlug ? await dataAdapter.getShelterBySlug(shelterSlug) : undefined;
const dogs = shelter ? await dataAdapter.getDogsByShelter(shelter.slug) : [];
const featuredDog = dogs.find((d) => d.disponible && !d.adoptado);

function impactFor(amount: number) {
  if (amount >= 80) return "una vacuna completa para un perrito";
  if (amount >= 30) return "3 días de comida para un perrito";
  if (amount > 0) return "1 día de comida para un perrito";
  return "un momento mejor para un perrito";
}

const constanciaId = `WS-${Date.now().toString(36).toUpperCase()}`;
const fecha = new Date().toLocaleString("es-PE", { dateStyle: "medium", timeStyle: "short" });
---

<Layout title="¡Gracias!">
  <div data-animate="hero-item" class="mx-auto max-w-md px-4 pb-10 pt-10 text-center">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-pill bg-success/10 text-success">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-8 w-8">
        <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>

    <h1 class="mt-4 text-2xl font-bold text-text-primary">¡Gracias!</h1>
    <p class="mt-1 text-text-secondary">
      {monto > 0 ? `Registramos tu aporte de ${formatSoles(monto)}` : "Registramos tu aporte"}
      {shelter && ` a ${shelter.nombre}`}.
    </p>

    <div class="mt-6 overflow-hidden rounded-card bg-surface text-left shadow-sm">
      {shelter && (
        <Image
          src={shelter.fotos[0]}
          alt={`Foto de ${shelter.nombre}`}
          width={600}
          height={300}
          class="aspect-video w-full object-cover"
        />
      )}
      <div class="p-4">
        <p class="text-sm font-semibold text-text-primary">Tu impacto: {impactFor(monto)}</p>
        <p class="mt-2 text-xs text-text-secondary">N° de constancia: {constanciaId}</p>
        <p class="text-xs text-text-secondary">{fecha}</p>
      </div>
    </div>

    <div class="mt-6 rounded-card bg-surface p-4 text-left shadow-sm">
      <Toggle
        client:visible
        label="¿Lo haces mensual?"
        description="Programa este mismo monto cada mes, sin compromisos — puedes pausarlo cuando quieras."
      />
    </div>

    <div class="mt-6 space-y-2">
      <ShareButton client:visible title="Wasitas" url={Astro.url.origin} />
      {featuredDog && shelter && (
        <a
          href={`/albergues/${shelter.slug}/perritos/${featuredDog.slug}`}
          class="block w-full rounded-pill border border-chip-bg py-3 text-sm font-semibold text-text-primary transition hover:bg-chip-bg"
        >
          Conocer a {featuredDog.nombre} en adopción
        </a>
      )}
      <a href="/" class="block pt-2 text-sm font-medium text-text-secondary">Volver al inicio</a>
    </div>
  </div>
</Layout>
