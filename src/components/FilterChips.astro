---
// Static quick-filter row (e.g. on Home): each chip navigates to /buscar
// pre-filtered. For live multi-select filtering see the React FilterChips
// used inside the SearchAndFilter island on /buscar.
import { tagLabel } from "../lib/format";
import type { ShelterTag } from "../lib/types";

interface Props {
  activeTag?: string;
  class?: string;
}

const { activeTag = "Urgente", class: className = "" } = Astro.props;
const tags: ShelterTag[] = ["Urgente", "Comida", "Veterinaria", "Adopcion"];
---

<div class:list={["flex gap-2 overflow-x-auto", className]} role="list">
  {tags.map((tag) => {
    const active = tag === activeTag;
    return (
      <a
        href={`/buscar?tag=${tag}`}
        role="listitem"
        aria-pressed={active}
        class:list={[
          "shrink-0 rounded-pill px-4 py-2 text-sm font-medium transition",
          active ? "bg-accent-urgent text-white" : "bg-chip-bg text-text-primary",
        ]}
      >
        {tagLabel(tag)}
      </a>
    );
  })}
</div>
