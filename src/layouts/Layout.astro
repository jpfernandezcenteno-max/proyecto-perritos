---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import BottomNav from "../components/BottomNav.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  showHeader?: boolean;
  showBottomNav?: boolean;
}

const {
  title,
  description = "Wasitas conecta a personas con albergues de perritos en Perú. Un yapeo cambia el día de un perrito.",
  ogImage,
  showHeader = true,
  showBottomNav = true,
} = Astro.props;

const pageTitle = title ? `${title} · Wasitas` : "Wasitas";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body class:list={["min-h-dvh bg-bg", showBottomNav && "has-bottom-nav"]}>
    {showHeader && <Header />}
    <main>
      <slot />
    </main>
    {showBottomNav && <BottomNav />}
  </body>
</html>
