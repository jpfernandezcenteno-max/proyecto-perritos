---
import Layout from "../layouts/Layout.astro";
import StatRow from "../components/StatRow.astro";
import DogCard from "../components/DogCard.astro";
import ThemeToggle from "../components/islands/ThemeToggle";
import MonthlyDonationCard from "../components/islands/MonthlyDonationCard";
import { actions } from "astro:actions";
import { dataAdapter } from "../lib/data";
import { formatSoles } from "../lib/format";

const logoutResult = Astro.getActionResult(actions.auth.logout);
if (logoutResult && !logoutResult.error) {
  return Astro.redirect("/");
}

if (!Astro.locals.user) {
  return Astro.redirect("/login");
}

const user = Astro.locals.user;

// TODO: reemplazar por datos reales de donaciones — ver "Persistencia real" en Pendiente de definir.
const donor = {
  nombre: user.nombre || user.email,
  iniciales: (user.nombre || user.email).slice(0, 2).toUpperCase(),
  donanteDesde: "marzo 2024",
};

const shelters = await dataAdapter.getShelters();
const mainShelter = shelters[0];
const allDogs = mainShelter ? await dataAdapter.getDogsByShelter(mainShelter.slug) : [];
const following = allDogs.slice(0, 2);

const historial = shelters.slice(0, 3).map((s, i) => ({
  shelter: s,
  fecha: new Date(Date.now() - (i + 1) * 1000 * 60 * 60 * 24 * 12).toLocaleDateString("es-PE", {
    day: "2-digit",
    month: "short",
  }),
  constancia: `WS-${(1000 + i * 37).toString(36).toUpperCase()}`,
  monto: [30, 50, 20][i] ?? 20,
}));

const totalDonado = historial.reduce((sum, h) => sum + h.monto, 0);
---

<Layout title="Mi cuenta">
  <div class="mx-auto max-w-6xl px-4 pb-10 pt-6 lg:px-8">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="flex h-12 w-12 items-center justify-center rounded-pill bg-accent-cta text-sm font-semibold text-white">
          {donor.iniciales}
        </span>
        <div>
          <p class="font-semibold text-text-primary">{donor.nombre}</p>
          <p class="text-xs text-text-secondary">Donante desde {donor.donanteDesde}</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <ThemeToggle client:load />
        <form method="POST" action={actions.auth.logout}>
          <button
            type="submit"
            class="rounded-pill border border-chip-bg px-3 py-2 text-xs font-semibold text-text-secondary transition hover:text-text-primary"
          >
            Cerrar sesión
          </button>
        </form>
      </div>
    </div>

    <div class="mt-6 lg:grid lg:grid-cols-[1fr_22rem] lg:items-start lg:gap-10">
      <div class="lg:order-2">
        {mainShelter && (
          <MonthlyDonationCard
            client:visible
            shelterName={mainShelter.nombre}
            monthlyAmount={30}
            nextReminder="1 de septiembre"
          />
        )}

        <StatRow
          class="mt-6 !grid-cols-2"
          stats={[
            { value: formatSoles(totalDonado), label: "Total donado" },
            { value: String(new Set(historial.map((h) => h.shelter.slug)).size), label: "Albergues apoyados" },
          ]}
        />
      </div>

      <div class="mt-8 lg:order-1 lg:mt-0">
        <section>
          <h2 class="font-bold text-text-primary">Mis yapeos</h2>
          <ul class="mt-3 divide-y divide-chip-bg overflow-hidden rounded-card bg-surface shadow-sm">
            {historial.map((h) => (
              <li class="flex items-center justify-between p-3">
                <div>
                  <p class="text-sm font-semibold text-text-primary">{h.shelter.nombre}</p>
                  <p class="text-xs text-text-secondary">{h.fecha} · {h.constancia}</p>
                </div>
                <span class="font-semibold text-text-primary">{formatSoles(h.monto)}</span>
              </li>
            ))}
          </ul>
        </section>

        {following.length > 0 && (
          <section class="mt-8">
            <h2 class="font-bold text-text-primary">Siguiendo en adopción</h2>
            <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
              {following.map((dog) => (
                <DogCard dog={dog} shelterSlug={mainShelter!.slug} />
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </div>
</Layout>
