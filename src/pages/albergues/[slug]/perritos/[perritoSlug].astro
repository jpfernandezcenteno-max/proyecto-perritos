---
import Layout from "../../../../layouts/Layout.astro";
import Badge from "../../../../components/Badge.astro";
import { dataAdapter } from "../../../../lib/data";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const shelters = await dataAdapter.getShelters();
  const paths = [];
  for (const shelter of shelters) {
    const dogs = await dataAdapter.getDogsByShelter(shelter.slug);
    for (const dog of dogs) {
      paths.push({ params: { slug: shelter.slug, perritoSlug: dog.slug }, props: { shelter, dog } });
    }
  }
  return paths;
}

const { shelter, dog } = Astro.props;

const statusVariant = {
  Esterilizado: "esterilizado",
  Vacunado: "vacunado",
  "En proceso": "en-proceso",
} as const;

const whatsappHref = shelter.contacto.whatsapp
  ? `https://wa.me/${shelter.contacto.whatsapp}?text=${encodeURIComponent(
      `Hola, quisiera saber más sobre ${dog.nombre} de ${shelter.nombre} para adoptar 🐶`,
    )}`
  : undefined;
---

<Layout title={`${dog.nombre} · ${shelter.nombre}`} description={dog.descripcion} ogImage={dog.fotos[0]}>
  <div class="relative">
    <Image
      src={dog.fotos[0]}
      alt={`Foto de ${dog.nombre}`}
      width={1000}
      height={1000}
      class="aspect-square w-full object-cover sm:aspect-video"
    />
    <a
      href={`/albergues/${shelter.slug}`}
      aria-label={`Volver al perfil de ${shelter.nombre}`}
      class="absolute left-4 top-4 flex h-9 w-9 items-center justify-center rounded-pill bg-surface/90 text-text-primary shadow-sm"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
        <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
    {dog.adoptado && <Badge variant="adoptada" class="absolute right-4 top-4" />}
  </div>

  <div class="mx-auto max-w-2xl px-4 pb-10 pt-5">
    <h1 class="text-2xl font-bold text-text-primary">{dog.nombre}</h1>
    <p class="mt-1 text-sm text-text-secondary">
      {dog.edad} · {dog.tamano}
      {dog.raza && ` · ${dog.raza}`}
    </p>

    <Badge variant={statusVariant[dog.estadoSalud]} class="mt-3" />

    {dog.temperamento && (
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">{dog.temperamento}</p>
    )}
    <p class="mt-2 text-sm leading-relaxed text-text-secondary">{dog.descripcion}</p>

    <p class="mt-4 text-sm text-text-secondary">
      De <a href={`/albergues/${shelter.slug}`} class="font-semibold text-text-primary underline">{shelter.nombre}</a>
    </p>

    {!dog.adoptado && (
      <div class="mt-6">
        {whatsappHref ? (
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full rounded-pill bg-accent-cta py-3 text-center text-sm font-semibold text-white"
          >
            Quiero adoptar a {dog.nombre}
          </a>
        ) : (
          // TODO: fallback formulario de contacto cuando el albergue no tiene WhatsApp registrado
          <p class="rounded-input bg-chip-bg p-3 text-center text-sm text-text-secondary">
            Contacta al albergue para más información sobre adopción.
          </p>
        )}
      </div>
    )}
  </div>
</Layout>
