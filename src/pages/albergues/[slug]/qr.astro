---
import Layout from "../../../layouts/Layout.astro";
import QRCard from "../../../components/QRCard.astro";
import ImpactReference from "../../../components/ImpactReference.astro";
import TrustNote from "../../../components/TrustNote.astro";
import QrActions from "../../../components/islands/QrActions";
import { dataAdapter } from "../../../lib/data";

const { slug } = Astro.params;
const shelter = slug ? await dataAdapter.getShelterBySlug(slug) : undefined;
if (!shelter) return Astro.redirect("/buscar");
---

<Layout title={`Yapea a ${shelter.nombre}`} showHeader={false}>
  <div class="min-h-dvh bg-text-primary px-4 py-6 text-white">
    <div class="mx-auto flex max-w-md items-center justify-between">
      <a href={`/albergues/${shelter.slug}`} aria-label="Cerrar" class="flex h-9 w-9 items-center justify-center rounded-pill bg-white/10">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
          <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round"></path>
        </svg>
      </a>
      <a
        href={`/albergues/${shelter.slug}/qr-pantalla-completa`}
        class="text-xs font-semibold text-white/70 underline"
      >
        Pantalla completa
      </a>
    </div>

    <div class="mx-auto mt-4 max-w-md text-center">
      <h1 class="text-2xl font-bold">Escanea y yapea</h1>
      <p class="mt-1 text-sm text-white/70">Todo lo que aportes llega directo a {shelter.nombre}, sin pasar por Wasitas.</p>
    </div>

    <QRCard
      class="mx-auto mt-6 max-w-md"
      shelterName={shelter.nombre}
      ruc={shelter.ruc}
      yapeName={shelter.yapeNombre}
      qrImage={shelter.qrImage}
    />

    <ol class="mx-auto mt-6 max-w-md space-y-2 text-sm text-white/80">
      <li>1. Abre Yape</li>
      <li>2. Toca "Yapear"</li>
      <li>3. Escanea este QR</li>
    </ol>

    <div class="mx-auto mt-6 max-w-md">
      <QrActions client:visible qrImage={shelter.qrImage} shelterName={shelter.nombre} shareUrl={Astro.url.href} />
    </div>

    <div class="mx-auto mt-8 max-w-md">
      <ImpactReference />
    </div>

    <div class="mx-auto mt-6 max-w-md">
      <TrustNote class="!bg-white/10 !text-white/70" />
    </div>

    <a
      href={`/albergues/${shelter.slug}/registrar-donacion`}
      class="mx-auto mt-6 block max-w-md text-center text-sm font-semibold text-white underline"
    >
      Ya yapeé → Registrar mi donación
    </a>
  </div>
</Layout>
