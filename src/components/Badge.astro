---
export type BadgeVariant =
  | "verificado"
  | "urgente"
  | "esterilizado"
  | "vacunado"
  | "en-proceso"
  | "adoptada";

interface Props {
  variant: BadgeVariant;
  class?: string;
}

const { variant, class: className = "" } = Astro.props;

const labels: Record<BadgeVariant, string> = {
  verificado: "✅ Verificado",
  urgente: "🚨 Urgente",
  esterilizado: "✂️ Esterilizado",
  vacunado: "💉 Vacunado",
  "en-proceso": "⏳ En proceso",
  adoptada: "🎉 ¡Adoptada!",
};

const styles: Record<BadgeVariant, string> = {
  verificado: "bg-success/10 text-success",
  urgente: "bg-accent-urgent text-white animate-pulse",
  esterilizado: "bg-success/10 text-success",
  vacunado: "bg-success/10 text-success",
  "en-proceso": "bg-chip-bg text-text-secondary",
  adoptada: "bg-success text-white",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1 rounded-pill px-2.5 py-1 text-xs font-semibold transition hover:scale-110",
    styles[variant],
    className,
  ]}
>
  {labels[variant]}
</span>
