---
import Layout from "../../../layouts/Layout.astro";
import Badge from "../../../components/Badge.astro";
import ProgressBar from "../../../components/ProgressBar.astro";
import DogCard from "../../../components/DogCard.astro";
import Tabs from "../../../components/Tabs.astro";
import FavoriteButton from "../../../components/islands/FavoriteButton";
import { dataAdapter } from "../../../lib/data";
import { Image } from "astro:assets";

const { slug } = Astro.params;
const shelter = slug ? await dataAdapter.getShelterBySlug(slug) : undefined;
if (!shelter) return Astro.redirect("/buscar");

const dogs = await dataAdapter.getDogsByShelter(shelter.slug);
const availableDogs = dogs.filter((d) => !d.adoptado);
---

<Layout title={shelter.nombre} description={shelter.descripcion} ogImage={shelter.fotos[0]}>
  <div class="relative">
    <Image
      src={shelter.fotos[0]}
      alt={`Foto de portada de ${shelter.nombre}`}
      width={1200}
      height={700}
      class="aspect-[4/3] w-full object-cover sm:aspect-video"
    />
    <a
      href="/buscar"
      aria-label="Volver a la búsqueda"
      class="absolute left-4 top-4 flex h-9 w-9 items-center justify-center rounded-pill bg-surface/90 text-text-primary shadow-sm"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
        <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
    <span class="absolute bottom-4 right-4 rounded-pill bg-text-primary/70 px-2.5 py-1 text-xs font-medium text-white">
      1/{shelter.fotos.length}
    </span>
  </div>

  <div class="mx-auto max-w-3xl px-4 pb-10 pt-5">
    <div class="flex items-center gap-1.5">
      <h1 class="text-2xl font-bold text-text-primary">{shelter.nombre}</h1>
      {shelter.verificado && (
        <Badge variant="verificado" class="!bg-transparent !p-0 [&>svg]:h-5 [&>svg]:w-5 [&>svg]:text-success" />
      )}
    </div>
    <p class="mt-1 text-sm text-text-secondary">
      {shelter.distrito} · {shelter.totalPerritos} perritos
      {shelter.anioVerificacion && ` · Verificado desde ${shelter.anioVerificacion}`}
    </p>

    <div class="mt-5 rounded-card bg-surface p-4 shadow-sm">
      <p class="text-sm font-semibold text-text-primary">{shelter.metaActual.descripcionCampania}</p>
      <ProgressBar current={shelter.metaActual.montoRecaudado} goal={shelter.metaActual.montoMeta} class="mt-3" />
      <p class="mt-2 text-xs text-text-secondary">{shelter.metaActual.numAportantes} personas ya aportaron</p>
    </div>

    <div class="mt-4 flex gap-3">
      <a
        href={`/albergues/${shelter.slug}/qr`}
        class="flex-1 rounded-pill bg-accent-cta py-3 text-center text-sm font-semibold text-white"
      >
        Ver QR para yapear
      </a>
      <FavoriteButton client:visible shelterName={shelter.nombre} />
    </div>

    <div class="mt-8">
      <Tabs
        tabs={[
          { id: "nosotros", label: "Nosotros" },
          { id: "adopcion", label: "Adopción" },
          { id: "gastos", label: "Gastos" },
          { id: "resenas", label: "Reseñas" },
        ]}
      >
        <Fragment slot="nosotros">
          <p class="text-sm leading-relaxed text-text-secondary">{shelter.descripcion}</p>
        </Fragment>

        <Fragment slot="adopcion">
          <div class="mb-3 flex items-center justify-between">
            <h2 class="font-semibold text-text-primary">Zona de adopción</h2>
            <span class="text-sm text-text-secondary">{availableDogs.length} disponibles</span>
          </div>
          {availableDogs.length > 0 ? (
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
              {availableDogs.map((dog) => (
                <DogCard dog={dog} shelterSlug={shelter.slug} />
              ))}
            </div>
          ) : (
            <p class="text-sm text-text-secondary">Por ahora no hay perritos disponibles para adopción.</p>
          )}
        </Fragment>

        <Fragment slot="gastos">
          {/* TODO: rendición de cuentas — pendiente de definir la fuente de datos real */}
          <p class="text-sm text-text-secondary">
            Próximamente: el detalle de en qué se usa cada aporte a este albergue.
          </p>
        </Fragment>

        <Fragment slot="resenas">
          {/* TODO: conectar con reseñas reales de donantes/adoptantes */}
          <p class="text-sm text-text-secondary">Todavía no hay reseñas para este albergue.</p>
        </Fragment>
      </Tabs>
    </div>
  </div>
</Layout>
