---
import Layout from "../../../layouts/Layout.astro";
import Badge from "../../../components/Badge.astro";
import ProgressBar from "../../../components/ProgressBar.astro";
import DogCard from "../../../components/DogCard.astro";
import Tabs from "../../../components/Tabs.astro";
import FavoriteButton from "../../../components/islands/FavoriteButton";
import { dataAdapter } from "../../../lib/data";
import { formatSoles, formatFecha } from "../../../lib/format";
import { Image } from "astro:assets";

const { slug } = Astro.params;
const shelter = slug ? await dataAdapter.getShelterBySlug(slug) : undefined;
if (!shelter) return Astro.redirect("/buscar");

const dogs = await dataAdapter.getDogsByShelter(shelter.slug);
const availableDogs = dogs.filter((d) => !d.adoptado);

const gastos = await dataAdapter.getGastosByShelter(shelter.slug);
const totalGastado = gastos.reduce((sum, g) => sum + g.monto, 0);

const resenas = await dataAdapter.getResenasByShelter(shelter.slug);
const promedioCalificacion =
  resenas.length > 0 ? resenas.reduce((sum, r) => sum + r.calificacion, 0) / resenas.length : 0;

const validTabs = ["nosotros", "adopcion", "gastos", "resenas"];
const tabParam = Astro.url.searchParams.get("tab");
const defaultTab = tabParam && validTabs.includes(tabParam) ? tabParam : "nosotros";
---

<Layout title={shelter.nombre} description={shelter.descripcion} ogImage={shelter.fotos[0]}>
  <div class="mx-auto max-w-6xl px-4 pt-4 pb-10 lg:grid lg:grid-cols-[1.1fr_1fr] lg:items-start lg:gap-10 lg:px-8 lg:pt-8">
    <div class="lg:sticky lg:top-20">
      <div class="relative overflow-hidden rounded-card sm:mx-0">
        <Image
          src={shelter.fotos[0]}
          alt={`Foto de portada de ${shelter.nombre}`}
          width={1200}
          height={700}
          class="h-64 w-full object-cover sm:h-80 lg:h-[26rem]"
        />
        <a
          href="/buscar"
          aria-label="Volver a la búsqueda"
          class="absolute left-4 top-4 flex h-9 w-9 items-center justify-center rounded-pill bg-surface/90 text-text-primary shadow-sm"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
            <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <span class="absolute bottom-4 right-4 rounded-pill bg-text-primary/70 px-2.5 py-1 text-xs font-medium text-white">
          1/{shelter.fotos.length}
        </span>
      </div>

      <div class="mt-5">
        <div class="flex items-center gap-1.5">
          <h1 class="text-2xl font-bold text-text-primary">{shelter.nombre}</h1>
          {shelter.verificado && <Badge variant="verificado" />}
        </div>
        <p class="mt-1 text-sm text-text-secondary">
          {shelter.distrito} · {shelter.totalPerritos} mascotas
          {shelter.anioVerificacion && ` · Verificado desde ${shelter.anioVerificacion}`}
        </p>

        <div class="mt-5 rounded-card bg-surface p-4 shadow-sm">
          <p class="text-sm font-semibold text-text-primary">{shelter.metaActual.descripcionCampania}</p>
          <ProgressBar current={shelter.metaActual.montoRecaudado} goal={shelter.metaActual.montoMeta} class="mt-3" />
          <p class="mt-2 text-xs text-text-secondary">{shelter.metaActual.numAportantes} personas ya aportaron</p>
        </div>

        <div class="mt-4 flex gap-3">
          <a
            href={`/albergues/${shelter.slug}/qr`}
            class="flex-1 rounded-pill bg-accent-cta py-3 text-center text-sm font-semibold text-white"
          >
            Ver QR para yapear
          </a>
          <FavoriteButton client:visible shelterName={shelter.nombre} />
        </div>
      </div>
    </div>

    <div class="mt-8 lg:mt-0">
      <Tabs
        defaultTab={defaultTab}
        tabs={[
          { id: "nosotros", label: "Nosotros" },
          { id: "adopcion", label: "Adopción" },
          { id: "gastos", label: "Gastos" },
          { id: "resenas", label: "Reseñas" },
        ]}
      >
        <Fragment slot="nosotros">
          <p class="text-sm leading-relaxed text-text-secondary">{shelter.descripcion}</p>
        </Fragment>

        <Fragment slot="adopcion">
          <div class="mb-3 flex items-center justify-between">
            <h2 class="font-semibold text-text-primary">Zona de adopción</h2>
            <span class="text-sm text-text-secondary">{availableDogs.length} disponibles</span>
          </div>
          {availableDogs.length > 0 ? (
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
              {availableDogs.map((dog) => (
                <DogCard dog={dog} shelterSlug={shelter.slug} />
              ))}
            </div>
          ) : (
            <p class="text-sm text-text-secondary">Por ahora no hay mascotas disponibles para adopción.</p>
          )}
        </Fragment>

        <Fragment slot="gastos">
          <div class="mb-3 flex items-center justify-between">
            <h2 class="font-semibold text-text-primary">En qué se usó tu aporte</h2>
            <span class="text-sm text-text-secondary">{formatSoles(totalGastado)} rendidos</span>
          </div>
          {gastos.length > 0 ? (
            <ul class="divide-y divide-chip-bg overflow-hidden rounded-card bg-surface shadow-sm">
              {gastos.map((gasto) => (
                <li class="flex items-center justify-between gap-3 p-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                      <span class="rounded-pill bg-chip-bg px-2 py-0.5 text-xs font-medium text-text-secondary">
                        {gasto.categoria}
                      </span>
                    </div>
                    <p class="mt-1 text-sm text-text-primary">{gasto.descripcion}</p>
                    <p class="mt-0.5 text-xs text-text-secondary">{formatFecha(gasto.fecha)}</p>
                  </div>
                  <span class="shrink-0 font-semibold text-text-primary">{formatSoles(gasto.monto)}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-text-secondary">Todavía no hay gastos registrados para este albergue.</p>
          )}
        </Fragment>

        <Fragment slot="resenas">
          <div class="mb-3 flex items-center justify-between">
            <h2 class="font-semibold text-text-primary">Reseñas</h2>
            {resenas.length > 0 && (
              <span class="text-sm text-text-secondary">
                ★ {promedioCalificacion.toFixed(1)} · {resenas.length} {resenas.length === 1 ? "reseña" : "reseñas"}
              </span>
            )}
          </div>
          {resenas.length > 0 ? (
            <div class="space-y-3">
              {resenas.map((resena) => (
                <div class="rounded-card bg-surface p-4 shadow-sm">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <p class="text-sm font-semibold text-text-primary">{resena.autor}</p>
                      <p class="text-xs text-text-secondary">
                        {resena.rol} · {formatFecha(resena.fecha)}
                      </p>
                    </div>
                    <span class="shrink-0 text-sm font-semibold text-accent-urgent" aria-label={`${resena.calificacion} de 5 estrellas`}>
                      {"★".repeat(resena.calificacion)}{"☆".repeat(5 - resena.calificacion)}
                    </span>
                  </div>
                  <p class="mt-2 text-sm leading-relaxed text-text-secondary">{resena.comentario}</p>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-sm text-text-secondary">Todavía no hay reseñas para este albergue.</p>
          )}
        </Fragment>
      </Tabs>
    </div>
  </div>
</Layout>
