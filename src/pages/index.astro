---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import FilterChips from "../components/FilterChips.astro";
import StatRow from "../components/StatRow.astro";
import ShelterCard from "../components/ShelterCard.astro";
import DogCard from "../components/DogCard.astro";
import WhyWasitas from "../components/WhyWasitas.astro";
import ContactSection from "../components/ContactSection.astro";
import { dataAdapter } from "../lib/data";
import { formatSoles, progressPercent } from "../lib/format";
import { Image } from "astro:assets";

const shelters = await dataAdapter.getShelters();

const dogsByShelter = await Promise.all(
  shelters.map(async (shelter) => ({
    shelter,
    dogs: (await dataAdapter.getDogsByShelter(shelter.slug)).filter((d) => !d.adoptado),
  })),
);
const adoptableDogs = dogsByShelter
  .flatMap(({ shelter, dogs }) => dogs.map((dog) => ({ dog, shelterSlug: shelter.slug })))
  .slice(0, 6);

const totalRecaudado = shelters.reduce((sum, s) => sum + s.metaActual.montoRecaudado, 0);
const totalYapeos = shelters.reduce((sum, s) => sum + s.metaActual.numAportantes, 0);

// Los que más necesitan ayuda primero: urgentes, luego por menor % de meta cubierta.
const needHelp = [...shelters]
  .sort((a, b) => {
    const aUrgent = a.tags.includes("Urgente") ? 0 : 1;
    const bUrgent = b.tags.includes("Urgente") ? 0 : 1;
    if (aUrgent !== bUrgent) return aUrgent - bUrgent;
    return (
      progressPercent(a.metaActual.montoRecaudado, a.metaActual.montoMeta) -
      progressPercent(b.metaActual.montoRecaudado, b.metaActual.montoMeta)
    );
  })
  .slice(0, 6);
---

<Layout title="Inicio">
  <section class="relative flex min-h-[88vh] items-end overflow-hidden lg:min-h-[92vh] lg:items-center">
    <Image
      src={shelters[0]?.fotos[0] ?? "https://placedog.net/1600/1200?id=20"}
      alt="Perrito feliz en un albergue de Wasitas"
      width={1600}
      height={1200}
      class="absolute inset-0 h-full w-full object-cover object-center lg:object-[70%_center]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/10 lg:bg-gradient-to-r lg:from-black/85 lg:via-black/40 lg:to-transparent"></div>

    <svg
      data-animate="bone-spin"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      class="absolute right-6 top-24 h-9 w-9 text-joy-yellow sm:h-11 sm:w-11 lg:right-14 lg:top-28"
      aria-hidden="true"
    >
      <rect x="4" y="9" width="16" height="6" rx="3"></rect>
      <circle cx="4" cy="7.5" r="2.5"></circle>
      <circle cx="4" cy="16.5" r="2.5"></circle>
      <circle cx="20" cy="7.5" r="2.5"></circle>
      <circle cx="20" cy="16.5" r="2.5"></circle>
    </svg>

    <div class="relative z-10 mx-auto w-full max-w-5xl px-4 pb-10 sm:pb-14 lg:pb-0">
      <div class="lg:max-w-lg">
        <h1 data-animate="hero-item" class="text-4xl font-extrabold leading-tight text-white drop-shadow-sm sm:text-5xl lg:text-6xl">
          Un yapeo<br />cambia el día<br />de un perrito. 🐾
        </h1>
        <p data-animate="hero-item" class="mt-3 max-w-md text-white/90">
          Encuentra un albergue cerca de ti, escanea su QR de Yape y aporta lo que quieras.
          Wasitas nunca toca el dinero.
        </p>

        <div data-animate="hero-item">
          <SearchBar class="mt-6" />
          <FilterChips class="mt-4" />
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 pb-10 pt-6 lg:pt-10">
    <div data-animate="hero-item">
      <StatRow
        class="mt-0"
        stats={[
          { value: formatSoles(totalRecaudado), label: "Recaudado" },
          { value: String(shelters.length), label: "Albergues" },
          { value: String(totalYapeos), label: "Yapeos" },
        ]}
      />
    </div>

    {needHelp.length > 0 && (
      <section class="gsap-reveal mt-8">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-lg font-bold text-text-primary">Necesitan ayuda hoy 💛</h2>
          <a href="/buscar" class="text-sm font-semibold text-text-secondary">Ver todos</a>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {needHelp.map((shelter) => (
            <ShelterCard shelter={shelter} />
          ))}
        </div>
      </section>
    )}

    {adoptableDogs.length > 0 && (
      <section class="gsap-reveal mt-8">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-lg font-bold text-text-primary">Mascotas en adopción 🐶🐱</h2>
          <a href="/adopcion" class="text-sm font-semibold text-text-secondary">Ver albergues</a>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
          {adoptableDogs.map(({ dog, shelterSlug }) => (
            <DogCard dog={dog} shelterSlug={shelterSlug} />
          ))}
        </div>
      </section>
    )}
  </div>

  <WhyWasitas />
  <ContactSection />
</Layout>
