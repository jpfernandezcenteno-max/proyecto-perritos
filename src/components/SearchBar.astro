---
interface Props {
  action?: string;
  value?: string;
  placeholder?: string;
  cancelable?: boolean;
  class?: string;
}

const {
  action = "/buscar",
  value = "",
  placeholder = "Busca un albergue o distrito",
  cancelable = false,
  class: className = "",
} = Astro.props;
---

<form action={action} method="get" class:list={["flex items-center gap-2", className]} role="search">
  <div class="flex flex-1 items-center gap-2 rounded-pill bg-surface px-4 py-3 shadow-sm">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 shrink-0 text-text-secondary" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m21 21-4.35-4.35" stroke-linecap="round"></path>
    </svg>
    <input
      type="search"
      name="q"
      value={value}
      placeholder={placeholder}
      aria-label={placeholder}
      class="w-full bg-transparent text-sm text-text-primary placeholder:text-text-secondary focus:outline-none"
    />
  </div>
  {cancelable && (
    <a href="/buscar" class="shrink-0 text-sm font-medium text-text-secondary">Cancelar</a>
  )}
</form>
